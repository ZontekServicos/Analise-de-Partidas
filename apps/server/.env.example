NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/world_cup_predictions?schema=public"
CORS_ORIGIN=http://localhost:5173

# Integracao football-data.org (opcional — sem isso o app sobe normalmente,
# so os endpoints de sync/status ficam indisponiveis/bloqueados). Pertence
# SOMENTE ao backend: nunca crie um VITE_* com essa chave.
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# Protecao provisoria das rotas administrativas /api/data-sync/* ate existir
# autenticacao real. Sem isso definido, as rotas ficam bloqueadas (fail-closed).
DATA_SYNC_SECRET=
